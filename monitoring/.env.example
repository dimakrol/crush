# Grafana admin login (change these before deploying).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Credentials postgres-exporter uses to reach the Postgres instance.
# Instance-level metrics are global across all databases, so the app's own
# superuser is fine for the basic phase.
PG_EXPORTER_USER=whitelabel
PG_EXPORTER_PASSWORD=whitelabel

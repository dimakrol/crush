NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/crash_pilot
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace_me_access_secret
JWT_ACCESS_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5174

ROUND_WAITING_SECONDS=5
ROUND_CRASHED_SECONDS=3
ROUND_GROWTH_RATE=0.06
INITIAL_DEMO_BALANCE=1000

# White-label (operator) seamless-wallet API. OPERATOR_* must match the
# white-label service's values. WALLET_API_URL is the local host port by
# default; docker-compose overrides it with the container address.
WALLET_API_URL=http://localhost:4200
OPERATOR_API_KEY=dev-operator-key
OPERATOR_SECRET=dev-operator-secret-change-me
GAME_ID=crash-pilot

NODE_ENV=development
PORT=4000

# Superuser credentials for the platform's crash_pilot database. Used ONLY at
# boot, to create the read-only role below. The runtime pool logs in as that
# role, so a bug in the backoffice cannot write to the game's data.
POSTGRES_ADMIN_URL=postgresql://whitelabel:whitelabel@localhost:5532/crash_pilot
POSTGRES_RO_USER=backoffice_ro
POSTGRES_RO_PASSWORD=backoffice_ro_dev

# The backoffice's own store: operator accounts + audit log.
SQLITE_PATH=./data/backoffice.db

# Signs the session cookie. Required — there is no default.
BACKOFFICE_JWT_SECRET=replace_me_backoffice_secret
BACKOFFICE_JWT_EXPIRES_IN=8h

# First admin, created at boot only while the users table is empty.
BACKOFFICE_ADMIN_USER=admin
BACKOFFICE_ADMIN_PASSWORD=admin

# All writes go through the platform's admin API. ADMIN_API_KEY must match the
# platform's value and never reaches the browser. PLATFORM_API_URL is the local
# host port by default; docker-compose overrides it with the container address.
PLATFORM_API_URL=http://localhost:4100
ADMIN_API_KEY=dev-admin-key

# Dev only: Nest proxies everything but /api (including the HMR websocket) here.
VITE_DEV_SERVER_URL=http://localhost:5175

# Age at which a PENDING wallet op / PENDING_STAKE bet counts as stuck.
STUCK_OP_MINUTES=5

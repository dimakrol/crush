# Host port mappings for the Docker Compose stack (docker-compose.yml).
# Defaults are deliberately non-standard so the stack runs ALONGSIDE any local
# `npm run dev` / local postgres / local redis without colliding. Copy to .env
# and edit to taste — or just rely on the defaults baked into docker-compose.yml.
#
# Container-internal ports are fixed (services talk via service names:
# redis:6379, backend:4000, postgres:5432, white-label:4000);
# these only change the HOST side.

FRONTEND_PORT=5274   # browse the app at http://localhost:5274
BACKEND_PORT=4100    # API + Socket.IO at http://localhost:4100
REDIS_PORT=6479      # connect redis-cli to localhost:6479
WHITELABEL_PORT=4200 # white-label API + lobby at http://localhost:4200
BACKOFFICE_PORT=4300 # operator console at http://localhost:4300
PG_PORT=5532         # connect psql to localhost:5532 (user/pass/db: whitelabel)

# Shared secret pair: the platform signs wallet calls, the white-label verifies.
# Both services MUST see identical values.
OPERATOR_API_KEY=dev-operator-key
OPERATOR_SECRET=dev-operator-secret-change-me
LOBBY_JWT_SECRET=dev-lobby-secret-change-me

# Guards the platform's operator-facing admin endpoints (pause/resume the round
# loop, force-crash the current round, replay money moves the outbox gave up on).
# The backoffice is the only caller; it sends this key server-to-server and never
# exposes it to the browser. Compose gives both services the same value.
ADMIN_API_KEY=dev-admin-key

# Backoffice (operator console). The two below have NO defaults in the service
# itself — Compose supplies dev values, and it will not boot without them.
BACKOFFICE_JWT_SECRET=dev-backoffice-secret-change-me
# Password of the read-only Postgres role the console creates for itself at boot
# and then reads `crash_pilot` through.
BACKOFFICE_RO_PASSWORD=backoffice_ro_dev
# First console account, created only while the users table is empty. Changing
# these later does nothing — manage accounts in the UI instead.
BACKOFFICE_ADMIN_USER=admin
BACKOFFICE_ADMIN_PASSWORD=admin
